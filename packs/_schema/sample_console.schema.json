{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sample_data/console.json",
  "description": "Sample identities, conversations and console rows the web app shows before their api exists (DECISIONS §15). Hand-written; never copied or derived from a licensed dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack", "pack_roles", "identities", "conversations", "datasets", "review_items", "documents", "feedback", "eval_reports", "runs", "traces", "audit", "costs", "users"],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "time": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"},
    "roles": {"type": "array", "items": {"type": "string"}},
    "row": {"type": "object"}
  },
  "properties": {
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "display_name"],
      "properties": {"name": {"$ref": "#/$defs/text"}, "display_name": {"$ref": "#/$defs/text"}}
    },
    "pack_roles": {"$ref": "#/$defs/roles"},
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user_id", "display_name", "roles"],
        "properties": {"user_id": {"$ref": "#/$defs/text"}, "display_name": {"$ref": "#/$defs/text"}, "roles": {"$ref": "#/$defs/roles"}}
      }
    },
    "conversations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conversation", "turns"],
        "properties": {
          "conversation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "pinned", "group_id", "updated_at"],
            "properties": {
              "id": {"$ref": "#/$defs/text"},
              "title": {"$ref": "#/$defs/text"},
              "pinned": {"type": "boolean"},
              "group_id": {"type": ["string", "null"]},
              "updated_at": {"$ref": "#/$defs/time"}
            }
          },
          "turns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["turn", "revision", "question", "question_lang", "events"],
              "properties": {"events": {"type": "array", "items": {"type": "object", "required": ["event", "trace_id"]}}}
            }
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "description", "grain", "time_column", "readable_roles", "columns"]}
    },
    "review_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "name", "kind", "status", "confidence", "body"],
        "properties": {"kind": {"enum": ["item", "proposal"]}, "status": {"enum": ["draft", "approved"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "size", "status", "roles", "uploaded_at"],
        "properties": {"status": {"enum": ["processing", "indexed", "failed"]}}
      }
    },
    "feedback": {
      "type": "array",
      "items": {"type": "object", "required": ["trace_id", "ts", "user_id", "rating", "question", "run_status"], "properties": {"rating": {"enum": ["like", "dislike"]}}}
    },
    "eval_reports": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "ts", "passed", "threshold", "layers", "categories", "failed_cases"]}
    },
    "runs": {
      "type": "array",
      "items": {"type": "object", "required": ["trace_id", "ts", "user_id", "role", "question", "status", "latency_ms", "cost_usd"]}
    },
    "traces": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object", "required": ["name"]}}},
    "audit": {
      "type": "array",
      "items": {"type": "object", "required": ["ts", "trace_id", "user_id", "role", "decision", "dataset", "blocked_tables", "reason"], "properties": {"decision": {"enum": ["ALLOW", "DENY"]}}}
    },
    "costs": {"type": "array", "items": {"type": "object", "required": ["day", "alias", "model", "calls", "cost_usd"]}},
    "users": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "username", "display_name", "roles", "enabled"]}
    }
  }
}
