{
  "$defs": {
    "ColumnInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "number",
            "date",
            "datetime",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "role": {
          "enum": [
            "dimension",
            "measure",
            "time"
          ],
          "title": "Role",
          "type": "string"
        },
        "format": {
          "anyOf": [
            {
              "enum": [
                "currency",
                "count",
                "ratio",
                "percent",
                "days",
                "number"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        }
      },
      "required": [
        "name",
        "type",
        "role"
      ],
      "title": "ColumnInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "columns": {
      "items": {
        "$ref": "#/$defs/ColumnInfo"
      },
      "minItems": 1,
      "title": "Columns",
      "type": "array"
    },
    "rows": {
      "items": {
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": "array"
      },
      "maxItems": 5000,
      "title": "Rows",
      "type": "array"
    },
    "row_count": {
      "minimum": 0,
      "title": "Row Count",
      "type": "integer"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "columns",
    "rows",
    "row_count"
  ],
  "title": "Result",
  "type": "object"
}
