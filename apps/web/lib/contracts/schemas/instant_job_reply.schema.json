      "title": "InstantJobView",
      "type": "object"
    },
    "InstantResult": {
      "additionalProperties": false,
      "properties": {
        "pack": {
          "title": "Pack",
          "type": "string"
        },
        "datasets": {
          "default": 0,
          "title": "Datasets",
          "type": "integer"
        },
        "relationships": {
          "default": 0,
          "title": "Relationships",
          "type": "integer"
        },
        "skipped": {
          "default": [],
