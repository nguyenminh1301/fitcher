        "total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        }
      },
      "required": [
        "id",
        "state"
      ],
      "title": "InstantStep",
      "type": "object"
    }
