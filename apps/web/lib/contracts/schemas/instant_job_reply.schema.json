            "type": "string"
          },
          "title": "Skipped",
          "type": "array"
        },
        "dropped": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Dropped",
          "type": "array"
        },
        "slow": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Slow",
          "type": "array"
        },
        "suggested_questions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Suggested Questions",
          "type": "array"
        }
      },
      "required": [
        "pack"
      ],
      "title": "InstantResult",
      "type": "object"
    },
    "InstantStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "marts",
            "profile",
            "files",
            "draft",
            "approve",
            "compile",
            "activate"
