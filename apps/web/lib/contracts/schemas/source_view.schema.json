{
  "$defs": {
    "SyncView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "status": {
          "enum": [
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "started_by": {
          "enum": [
            "manual",
            "schedule",
            "setup"
          ],
          "title": "Started By",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finished At"
        },
        "results": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Results",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "enum": [
                "unreachable",
                "refused",
                "authentication",
                "tls",
                "database_not_found",
                "permission",
                "unknown",
                "interrupted"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        }
      },
      "required": [
        "id",
        "status",
        "started_by",
        "started_at",
        "finished_at",
        "results",
        "error"
      ],
      "title": "SyncView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "postgres",
        "mysql",
        "sqlserver",
        "file"
      ],
      "title": "Kind",
      "type": "string"
    },
    "host": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Host"
    },
    "port": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Port"
    },
    "database": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Database"
    },
    "schema_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Schema Name"
    },
    "user": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "User"
    },
    "tls_mode": {
      "enum": [
        "prefer",
        "require",
        "verify"
      ],
      "title": "Tls Mode",
      "type": "string"
    },
    "has_ca": {
      "title": "Has Ca",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "table_count": {
      "title": "Table Count",
      "type": "integer"
    },
    "selected_count": {
      "title": "Selected Count",
      "type": "integer"
    },
    "last_sync": {
      "anyOf": [
        {
          "$ref": "#/$defs/SyncView"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "host",
    "port",
    "database",
    "schema_name",
    "user",
    "tls_mode",
    "has_ca",
    "created_at",
    "table_count",
    "selected_count",
    "last_sync"
  ],
  "title": "SourceView",
  "type": "object"
}
