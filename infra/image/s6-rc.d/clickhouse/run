#!/command/with-contenv sh
# The embedded ClickHouse server, configured by init-data under /run/fitcher/clickhouse.
# With CLICKHOUSE_URL the external server is used and this service only holds its place.
if [ -n "${CLICKHOUSE_URL:-}" ]; then
    exec s6-pause
fi
exec 2>&1
exec clickhouse server --config-file=/run/fitcher/clickhouse/config.xml
