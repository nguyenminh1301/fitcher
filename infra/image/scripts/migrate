#!/command/with-contenv sh
# Waits for ClickHouse, restores a pending backup (jobs/restore.py), then applies the pending schema changes as the ClickHouse admin (jobs/migrate.py).
# s6 starts it as root; it runs as `app`, the owner of /data.
[ "$(id -u)" = 0 ] && exec env HOME=/home/app TMPDIR=/tmp/app /command/s6-setuidgid app "$0" "$@"
set -a
. /data/secrets/admin.env
set +a
cd /app
tries=0
until python -c "import os, urllib.request; urllib.request.urlopen('http://%s:%s/ping' % (os.environ['CLICKHOUSE_HOST'], os.environ['CLICKHOUSE_HTTP_PORT']), timeout=2)" 2>/dev/null; do
    tries=$((tries + 1))
    if [ "$tries" -ge 120 ]; then
        echo "migrate: ClickHouse at $CLICKHOUSE_HOST:$CLICKHOUSE_HTTP_PORT did not answer within 120 seconds" >&2
        exit 1
    fi
    sleep 1
done
python -m jobs.restore --finish
exec python -m jobs.migrate
