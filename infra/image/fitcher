#!/bin/sh
# Runs a job module of the release image: `docker exec fitcher fitcher <job> [args]` (DECISIONS §3).
# Jobs get the admin environment written by init-data, which the long-running api never holds.
set -e
if [ $# -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    echo "usage: fitcher <job> [args]; jobs:" >&2
    ls /app/jobs | sed -n 's/^\([a-z_]*\)\.py$/  \1/p' | grep -v '__init__' >&2
    exit 2
fi
job=$(printf '%s' "$1" | tr '-' '_')
case "$job" in
    *[!a-z_]* | _*) echo "fitcher: unknown job $1" >&2; exit 2 ;;
esac
[ -f "/app/jobs/$job.py" ] || { echo "fitcher: unknown job $1" >&2; exit 2; }
shift
set -a
. /data/secrets/admin.env
set +a
cd /app
exec python -m "jobs.$job" "$@"
