<clickhouse>
    <!--
        The api's conversation store (DECISIONS §10, §15): it writes each
        question and answer synchronously and reads a conversation back for
        its owner, so follow-up questions see the previous turn. It reaches
        only the conversation tables; every query filters by the requesting
        user. The password comes from the clickhouse container environment.
    -->
    <users>
        <agent_conversations>
            <password from_env="CLICKHOUSE_CONVERSATIONS_PASSWORD"/>
            <profile>default</profile>
            <quota>default</quota>
            <networks>
                <ip>::/0</ip>
            </networks>
            <grants>
                <query>GRANT SELECT, INSERT ON agent_logs.chat_messages</query>
                <query>GRANT SELECT, INSERT ON agent_logs.conversations</query>
                <query>GRANT SELECT, INSERT ON agent_logs.conversation_groups</query>
            </grants>
        </agent_conversations>
    </users>
</clickhouse>
