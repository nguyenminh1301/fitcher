<clickhouse>
    <!--
        source_loader is the only user that may use the source named collections
        (config.d/sources.xml). jobs.sync_sources connects as it to copy a source
        into raw.<source>__<table> and to define the live src_<source> databases.
        It cannot read marts, agent_logs or the agent roles' objects, and no
        agent role is granted anything on raw or src_* (DECISIONS §4 and §9).
        The password comes from CLICKHOUSE_SOURCES_PASSWORD.
    -->
    <users>
        <source_loader>
            <password from_env="CLICKHOUSE_SOURCES_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <grants>
                <!-- Lists the collections; without SHOW NAMED COLLECTIONS SECRETS their values stay hidden. -->
                <query>GRANT NAMED COLLECTION, SHOW NAMED COLLECTIONS ON *</query>
                <query>GRANT SELECT ON system.named_collections</query>
                <query>GRANT READ ON POSTGRES, READ ON MYSQL, READ ON MONGO, READ ON S3</query>
                <query>GRANT TABLE ENGINE ON PostgreSQL, TABLE ENGINE ON MySQL, TABLE ENGINE ON MongoDB, TABLE ENGINE ON S3, TABLE ENGINE ON MergeTree</query>
                <query>GRANT CREATE TEMPORARY TABLE ON *.*</query>
                <query>GRANT SELECT, INSERT, CREATE TABLE, DROP TABLE ON raw.*</query>
                <!--
                    ClickHouse requires INSERT to create a table on a writable
                    engine; the source system's read-only user still refuses any write.
                -->
                <query>GRANT SELECT, INSERT, CREATE DATABASE, CREATE TABLE, DROP TABLE, DROP DATABASE ON src_*.*</query>
            </grants>
        </source_loader>
    </users>
</clickhouse>
