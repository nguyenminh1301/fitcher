# Copy to root .env and replace every change-me value. Never commit .env or
# pass it to the web build.

# ClickHouse admin user; the passwordless default user is disabled.
CLICKHOUSE_ADMIN_USER=finch_admin
CLICKHOUSE_ADMIN_PASSWORD=change-me

# Secret from which compile_pack derives the password of each pack role's
# read-only ClickHouse user; the api derives the same passwords to connect.
CLICKHOUSE_AGENT_PASSWORD=change-me

# agent_logs users (infra/clickhouse/users.d/agent_logs.xml): the insert-only
# log writer, the trace reader and the review reader.
CLICKHOUSE_LOGS_WRITER_PASSWORD=change-me
CLICKHOUSE_TRACE_READER_PASSWORD=change-me
CLICKHOUSE_REVIEW_READER_PASSWORD=change-me

# agent_query_stopper (infra/clickhouse/users.d/agent_query_stopper.xml): the
# api stops the query of an answer whose client disconnected; it reads no data.
CLICKHOUSE_QUERY_STOPPER_PASSWORD=change-me

# agent_conversations (infra/clickhouse/users.d/agent_conversations.xml): the
# api reads and writes the asking user's conversations and their messages.
CLICKHOUSE_CONVERSATIONS_PASSWORD=change-me

# model_tiers_admin (infra/clickhouse/users.d/model_tiers.xml): the api reads
# and writes the model tier mapping of the console's Models page.
CLICKHOUSE_MODEL_TIERS_PASSWORD=change-me

# pack_review (infra/clickhouse/users.d/pack_review.xml): the api writes the
# document registry and test-runs reviewed metrics and examples on marts.
CLICKHOUSE_PACK_REVIEW_PASSWORD=change-me

# source_loader (infra/clickhouse/users.d/sources.xml): the only ClickHouse user
# that may use the source named collections; jobs.sync_sources connects as it.
CLICKHOUSE_SOURCES_PASSWORD=change-me

# Data sources (jobs/README.md, Data sources). Each source manifest's
# connection_env prefix names five variables that only ClickHouse receives,
# read by its named collection in infra/clickhouse/config.d/sources.xml:
# <PREFIX>_HOST, _PORT, _DATABASE (the bucket of a files source), _USER and
# _PASSWORD of a read-only user on the source system. The values below serve
# the lab fixtures of `docker compose --profile sources up -d --wait`, whose
# seeds also receive them; the MySQL seed puts its passwords in SQL literals,
# so avoid quotes. FIXTURE_ADMIN_PASSWORD is each fixture's own administrator.
FIXTURE_ADMIN_PASSWORD=change-me
FIXTURE_POSTGRES_HOST=postgres-fixture
FIXTURE_POSTGRES_PORT=5432
FIXTURE_POSTGRES_DATABASE=widgets
FIXTURE_POSTGRES_USER=widgets_reader
FIXTURE_POSTGRES_PASSWORD=change-me

# Iowa Liquor Sales 2025 (infra/sources/iowa_liquor), a second industry's data in
# the same PostgreSQL fixture; seed.sh creates this read-only role.
IOWA_LIQUOR_POSTGRES_HOST=postgres-fixture
IOWA_LIQUOR_POSTGRES_PORT=5432
IOWA_LIQUOR_POSTGRES_DATABASE=iowa_liquor
IOWA_LIQUOR_POSTGRES_USER=iowa_liquor_reader
IOWA_LIQUOR_POSTGRES_PASSWORD=change-me
FIXTURE_MYSQL_HOST=mysql-fixture
FIXTURE_MYSQL_PORT=3306
FIXTURE_MYSQL_DATABASE=widgets
FIXTURE_MYSQL_USER=widgets_reader
FIXTURE_MYSQL_PASSWORD=change-me
FIXTURE_MONGODB_HOST=mongodb-fixture
FIXTURE_MONGODB_PORT=27017
FIXTURE_MONGODB_DATABASE=widgets
FIXTURE_MONGODB_USER=widgets_reader
FIXTURE_MONGODB_PASSWORD=change-me
FIXTURE_FILES_HOST=files-fixture
FIXTURE_FILES_PORT=8333
FIXTURE_FILES_DATABASE=widgets
FIXTURE_FILES_USER=widgets_reader
FIXTURE_FILES_PASSWORD=change-me

# Limits applied to every agent query; the agent user's profile caps them.
QUERY_MAX_EXECUTION_TIME=30
QUERY_MAX_RESULT_ROWS=10000
QUERY_MAX_MEMORY_USAGE=2000000000

# agent_logs writer in the api: records per batch, flush interval and the
# bound of its queue; records beyond it are counted as lost for their run.
LOG_BATCH_SIZE=100
LOG_FLUSH_INTERVAL_MS=1000
LOG_QUEUE_MAX=10000

# Optional: on the first start that finds no model provider in the app state,
# the api and the jobs create one from each of these and map every model tier
# to the first one's proposed models (DECISIONS §2). Afterwards providers, keys
# and tiers are managed in the setup and on the Models page, and these values
# are no longer read. Keys are stored encrypted in the data volume.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Set to http://ollama:11434 with the local-models profile, or to
# http://host.docker.internal:11434 for a model server on the host.
OLLAMA_URL=

# Domain Pack the api serves; compile it first with jobs.compile_pack.
ACTIVE_PACK=ecommerce_twin

# Most frequent values indexed per indexable column.
COLUMN_VALUES_TOP_K=10000

# Individual mode (no sign-in) answers only on localhost. List other names,
# comma-separated, to reach it from elsewhere: anyone who can reach such a
# name controls the instance, and the interface says so. Behind a reverse
# proxy, listing its public name also makes the api trust X-Forwarded-Proto.
FITCHER_ALLOWED_HOSTS=

# Password jobs.seed_dev_accounts gives every development account of
# infra/dev/accounts.yaml (lab.analyst, lab.marketing, ...), at least 8
# characters; never committed, never printed. Development only.
DEV_ACCOUNT_PASSWORD=change-me

# Input screening before any LLM call (DECISIONS §9). log records each
# question's verdict and lets it continue; enforce also stops a blocked one.
# Switch to enforce only after jobs.screen_eval shows no false positive and at
# least 90% recall in English and Vietnamese. A score at or above
# SCREEN_FLAG_AT flags a question, at or above SCREEN_BLOCK_AT blocks it.
SCREEN_MODE=log
SCREEN_FLAG_AT=0.5
SCREEN_BLOCK_AT=0.9

# Hugging Face token for `docker compose run --rm guard-model`, which fetches
# the gated classifier meta-llama/Llama-Prompt-Guard-2-86M after its licence is
# accepted on Hugging Face. Only the guard-model service receives it; never
# commit it. Without the classifier every question gets the blocked reply.
HF_TOKEN=

# Questions each user may ask the api per minute, refilled evenly; above it
# /ask answers 429 before any work starts.
RATE_LIMIT_PER_MINUTE=10

# Largest company document a reviewer may upload, in bytes (20 MB).
DOCUMENT_MAX_BYTES=20971520

# Root of the persistent application files: the app state (app.db) and the
# instance secret key (secret.key). Compose mounts the fitcher-data volume at
# /data; outside Compose point it at a local directory (not a network file system).
FITCHER_DATA_DIR=/data

# Key that encrypts stored secrets: base64 of 32 random bytes
# (openssl rand -base64 32). Leave empty to generate <FITCHER_DATA_DIR>/secret.key
# on first use. Losing the key makes stored secrets unreadable; back up the volume.
FITCHER_SECRET_KEY=
