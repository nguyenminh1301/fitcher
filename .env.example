# Copy to root .env. Never commit real secrets or pass this file to the web build.
OPENAI_API_KEY=
# The explicit smoke check sends one small Responses API request.
OPENAI_SMOKE_MODEL=gpt-6-luna
# Planned settings for later SQL, summary and embedding phases.
OPENAI_SQL_MODEL=gpt-6.1-sol
OPENAI_SUMMARY_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Local development only; change the password outside this local lab.
POSTGRES_USER=fitcher
POSTGRES_PASSWORD=fitcher-local-only
POSTGRES_DB=fitcher
