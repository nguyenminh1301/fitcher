# Copy to root .env and replace every change-me value. Never commit .env or
# pass it to the web build.

# ClickHouse admin user; the passwordless default user is disabled.
CLICKHOUSE_ADMIN_USER=finch_admin
CLICKHOUSE_ADMIN_PASSWORD=change-me

# Secret from which compile_pack derives the password of each pack role's
# read-only ClickHouse user; the api derives the same passwords to connect.
CLICKHOUSE_AGENT_PASSWORD=change-me

# agent_logs users (infra/clickhouse/users.d/agent_logs.xml): the insert-only
# log writer, the trace reader and the review reader.
CLICKHOUSE_LOGS_WRITER_PASSWORD=change-me
CLICKHOUSE_TRACE_READER_PASSWORD=change-me
CLICKHOUSE_REVIEW_READER_PASSWORD=change-me

# Limits applied to every agent query; the agent user's profile caps them.
QUERY_MAX_EXECUTION_TIME=30
QUERY_MAX_RESULT_ROWS=10000
QUERY_MAX_MEMORY_USAGE=2000000000

# agent_logs writer in the api: records per batch, flush interval and the
# bound of its queue; records beyond it are counted as lost for their run.
LOG_BATCH_SIZE=100
LOG_FLUSH_INTERVAL_MS=1000
LOG_QUEUE_MAX=10000

# LiteLLM proxy key, used by api and jobs to call the aliases.
LITELLM_MASTER_KEY=sk-change-me

# OpenAI models behind each alias; changing one needs no code change.
LITELLM_MODEL_FAST=openai/gpt-5.4-mini
LITELLM_MODEL_SQL_GEN=openai/gpt-5.4
LITELLM_MODEL_SQL_GEN_HARD=openai/gpt-5.5
LITELLM_MODEL_EMBED=openai/text-embedding-3-large

# Passed to the litellm container only; required for make smoke, not for health.
OPENAI_API_KEY=

# Domain Pack the api serves; compile it first with jobs.compile_pack.
ACTIVE_PACK=ecommerce_twin

# Vector size requested from the embed alias; changing it needs a recompile.
EMBEDDING_DIMENSIONS=1024

# Most frequent values indexed per indexable column.
COLUMN_VALUES_TOP_K=10000

# Keycloak bootstrap administrator.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Password jobs.set_lab_passwords gives every lab user of the finch realm
# (lab.analyst, lab.marketing, ...); never committed, never printed.
KEYCLOAK_LAB_USER_PASSWORD=change-me

# Access tokens the api accepts: the issuer as browsers address Keycloak, the
# audience the finch-web and finch-cli clients add, and where the api reads the
# realm's signing keys.
KEYCLOAK_ISSUER=http://localhost:8080/realms/finch
KEYCLOAK_AUDIENCE=finch-api
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/finch/protocol/openid-connect/certs

# OpenSearch heap; keep Xms and Xmx equal.
OPENSEARCH_JAVA_OPTS="-Xms1g -Xmx1g"
